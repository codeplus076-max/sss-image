# Application Configuration
APP_NAME=sonar-backend
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=https://side-scan-sonar-sigma.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL / Supabase or SQLite fallback for local development)
# PostgreSQL/PostGIS: postgresql+psycopg2://postgres:password@localhost:5432/sonarops
# Supabase: postgresql+psycopg2://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./sonarops.db

# Storage Configuration ('local' or 'supabase')
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=storage/sonar-evidence

# Supabase Storage Configuration (Optional, enabled when STORAGE_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sonar-evidence
