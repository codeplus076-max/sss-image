# ==============================================================================
# SIH26057 Side-Scan Sonar Marine Intelligence Platform — Environment Template
# ==============================================================================
# Copy this template to .env in your respective environment directories as needed:
#   backend/.env   - Backend runtime settings
#   frontend/.env  - Frontend client settings
#
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND SETTINGS (backend/.env)
# ------------------------------------------------------------------------------
APP_NAME=sonar-backend
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Allowed Origins (comma-separated list for local development)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (SQLite local database file auto-initialized on startup)
DATABASE_URL=sqlite:///./sonarops.db

# Storage Provider ('local' for local filesystem evidence storage)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=storage/sonar-evidence

# Supabase Storage Configuration (Optional, only needed if STORAGE_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sonar-evidence

# ------------------------------------------------------------------------------
# FRONTEND SETTINGS (frontend/.env)
# ------------------------------------------------------------------------------
# API calls use /api on the website domain.
# Configure the backend proxy in frontend/vite.config.js and frontend/vercel.json.
