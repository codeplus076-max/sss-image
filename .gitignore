# ==========================================
# Root .gitignore — SIH26057 Side-Scan Sonar
# ==========================================

# Python compiled bytecode & runtime artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
env/
venv/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Local databases and runtime evidence storage (auto-initialized on startup)
*.db
sonarops.db
backend/sonarops.db
storage/
backend/storage/
backend/.cache/
logs/
*.log

# Temporary test/scratch scratchpads
scratch/
*_crop.png
backend/*_crop.png

# Frontend dependencies & build outputs
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variable secrets (preserve .env.example templates)
.env
.env.local
.env.*.local
.env.production
backend/.env
frontend/.env
frontend/.env.production
!.env.example
!backend/.env.example
!frontend/.env.example

# IDE & OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
